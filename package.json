{
  "name": "audiority",
  "version": "0.1.0",
  "description": "Local, channel-safe video audio conversion",
  "author": "Audiority contributors",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:ui": "electron scripts/ui-smoke.js",
    "benchmark": "electron scripts/benchmark.js",
    "prepare:tools": "node scripts/prepare-tools.js",
    "pack": "npm run prepare:tools && electron-builder --dir",
    "dist:mac": "npm run prepare:tools && electron-builder --mac",
    "dist:win": "npm run prepare:tools && electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.audiority.desktop",
    "productName": "Audiority",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json", "LICENSE"],
    "extraResources": [{ "from": "resources/tools", "to": "tools" }],
    "mac": { "category": "public.app-category.video", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}