{
  "name": "audiority",
  "version": "1.0.2",
  "description": "Local, channel-safe video audio conversion",
  "author": "Audiority contributors",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:ui": "electron scripts/ui-smoke.js",
    "benchmark": "electron scripts/benchmark.js",
    "prepare:tools": "node scripts/prepare-tools.js",
    "pack": "npm run prepare:tools && electron-builder --dir",
    "dist:mac": "npm run prepare:tools -- mac && electron-builder --mac --arm64",
    "dist:win": "npm run prepare:tools -- win && electron-builder --win --x64"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.audiority.desktop",
    "icon": "build/icon.png",
    "productName": "Audiority",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json", "LICENSE"],
    "extraResources": [{ "from": "build/license.txt", "to": "license.txt" }],
    "mac": { "category": "public.app-category.video", "target": ["dmg"], "extraResources": [{ "from": "legal-tools", "to": "tools", "filter": ["**/*", "!.DS_Store"] }] },
    "win": { "target": ["nsis"], "extraResources": [{ "from": "legal-tools-win", "to": "tools", "filter": ["**/*", "!.DS_Store"] }] },
    "dmg": { "license": "build/license.txt" },
    "nsis": { "oneClick": false, "perMachine": true, "allowToChangeInstallationDirectory": true, "license": "build/license.txt" }
  }
}